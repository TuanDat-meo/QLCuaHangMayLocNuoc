{
  "name": "aquacare-firebase",
  "version": "1.0.0",
  "description": "AquaCareSystem Firebase Configuration",
  "scripts": {
    "start": "firebase emulators:start --only firestore",
    "start:all": "firebase emulators:start",
    "seed": "node seed_firestore.js",
    "seed:clear": "node -e \"require('firebase-admin').initializeApp({projectId:'demo-aquacare-local'}); require('firebase-admin').firestore().recursiveDelete(require('firebase-admin').firestore().collection('nguoiDung').parent).catch(e=>console.log(e))\"",
    "seed:reset": "npm run seed",
    "deploy": "firebase deploy",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0"
  }
}
