rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra vai trò Admin (Role = 1)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 1 ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == '1');
    }

    // Hàm kiểm tra quyền nhân viên (Role <= 3: Admin, Coordinator, Staff)
    function isStaff() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 1 ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == '1' ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 2 ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == '2' ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 3 ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == '3');
    }

    // Hàm kiểm tra vai trò Kỹ thuật viên (Role = 4)
    function isTechnician() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 4 ||
              get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == '4');
    }

    // Quy tắc đọc: Cho phép tất cả người dùng đã đăng nhập đọc mọi dữ liệu
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Nhà cung cấp & Phiếu nhập (Thêm mới)
    match /suppliers/{document=**} {
      allow write: if isStaff();
    }

    match /importVouchers/{document=**} {
      allow write: if isStaff();
    }

    // Bộ sưu tập Vai trò (Roles)
    match /roles/{roleId} {
      allow write: if isAdmin();
    }

    // Người dùng (nguoiDung)
    match /nguoiDung/{uid} {
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Đơn hàng 
    match /donHang/{orderId} {
      allow create: if request.auth != null 
        && request.resource.data.customerId == request.auth.uid;

      // Customer chỉ được cancel đơn của mình khi còn pending
      allow update: if request.auth != null
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled';

      // Staff hoặc Kỹ thuật viên update
      allow update: if isStaff() || isTechnician();
      allow delete: if isStaff();
    }

    // Xóa hoặc giữ wildcard nếu cần sub-collections
    match /donHang/{orderId}/{document=**} {
      allow write: if isStaff() || isTechnician();
    }

    // Sản phẩm (Cho phép Staff/Accountant nhập kho thì nên để <= 3 hoặc cho phép update cụ thể)
    match /sanPham/{document=**} {
      allow write: if isStaff(); 
    }

    // Nhật ký hoạt động
    match /nhatKyHoatDong/{document=**} {
      allow write: if request.auth != null;
    }
  }
}