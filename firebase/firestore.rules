rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────
    
    /// Check if user is Admin (Role = 1)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 1;
    }

    /// Check if user is Technician (Role = 2)
    function isTechnician() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 2;
    }

    /// Check if user is Staff (Role = 3)
    function isStaff() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role == 3;
    }

    /// Validate order item structure
    function isValidOrderItem(item) {
      return item.keys().hasAll(['id', 'productId', 'productName', 'price', 'quantity', 'subtotal']) &&
             item.id is string &&
             item.productId is string &&
             item.productName is string &&
             item.price is number &&
             item.quantity is number &&
             item.subtotal is number &&
             item.price >= 0 &&
             item.quantity >= 1 &&
             item.subtotal >= 0;
    }

    /// Validate delivery address structure
    function isValidDeliveryAddress(addr) {
      return addr.keys().hasAll(['type', 'recipientName', 'street', 'ward', 'district', 'city']) &&
             addr.type is string &&
             addr.recipientName is string &&
             addr.street is string &&
             addr.ward is string &&
             addr.district is string &&
             addr.city is string &&
             addr.street.size() > 0 &&
             addr.ward.size() > 0 &&
             addr.district.size() > 0 &&
             addr.city.size() > 0;
    }

    /// Validate technician structure
    function isValidTechnician(tech) {
      return tech.keys().hasAll(['id', 'name', 'phone']) &&
             tech.id is string &&
             tech.name is string &&
             tech.phone is string &&
             tech.id.size() > 0 &&
             tech.name.size() > 0 &&
             tech.phone.size() > 0;
    }

    /// Validate order data
    function isValidOrderData(data) {
      return data.keys().hasAll([
        'customerId', 'customerName', 'phoneNumber', 
        'deliveryAddress', 'items', 'totalAmount', 'status'
      ]) &&
      data.customerId is string &&
      data.customerName is string &&
      data.phoneNumber is string &&
      data.totalAmount is number &&
      data.status is string &&
      data.customerId.size() > 0 &&
      data.customerName.size() > 0 &&
      data.phoneNumber.size() > 0 &&
      data.totalAmount >= 0 &&
      isValidDeliveryAddress(data.deliveryAddress) &&
      data.items is list &&
      data.items.size() > 0 &&
      data.items.all(item => isValidOrderItem(item));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Global Read Rules
    // ─────────────────────────────────────────────────────────────────────────
    
    // Allow authenticated users to read all documents
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Roles Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /roles/{roleId} {
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Users Collection (nguoiDung)
    // ─────────────────────────────────────────────────────────────────────────
    match /nguoiDung/{uid} {
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Orders Collection (donHang)
    // ─────────────────────────────────────────────────────────────────────────
    match /donHang/{orderId} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow create for customers (any authenticated user) and staff
      allow create: if request.auth != null &&
                   isValidOrderData(request.resource.data) &&
                   request.resource.data.customerId == request.auth.uid &&
                   (
                     !request.resource.data.keys().hasAny(['updatedBy', 'updatedByName']) ||
                     (
                       exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role <= 3
                     )
                   );
      
      // Allow update for order owner, admin, and staff
      allow update: if request.auth != null &&
                   (
                     resource.data.customerId == request.auth.uid ||
                     isAdmin() ||
                     isStaff()
                   ) &&
                   (
                     // If updating status or other order fields, ensure valid data
                     !request.resource.data.keys().hasAll(['customerId']) ||
                     isValidOrderData(request.resource.data)
                   );
      
      // Allow delete for admin only (for pending orders)
      allow delete: if isAdmin() && resource.data.status == 'pending';
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Products Collection (sanPham)
    // ─────────────────────────────────────────────────────────────────────────
    match /sanPham/{document=**} {
      allow write: if request.auth != null &&
                   exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data.role <= 2;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Activity Log Collection (nhatKyHoatDong)
    // ─────────────────────────────────────────────────────────────────────────
    match /nhatKyHoatDong/{document=**} {
      allow write: if request.auth != null;
    }
  }
}
