rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // QUY TẮC PHÁT TRIỂN: Cho phép Đọc và Ghi vào TẤT CẢ các bảng nếu đã đăng nhập
    // Đảm bảo script Seed và tính năng Hóa đơn không bị chặn quyền
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
